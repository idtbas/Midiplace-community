# RenOS – Beispielkonfiguration. Kopiere diese Datei nach `.env` und passe sie an.
# Echte Zugangsdaten gehören niemals ins Repository.

# Laufzeitmodus: development | production
NODE_ENV=development

# Adresse, auf der der App-/API-Server lauscht (liefert in Produktion auch das Frontend aus).
RENOS_HOST=127.0.0.1
RENOS_PORT=8787

# Eigener Server für Spielinhalte (getrennter Origin!).
RENOS_GAME_HOST=127.0.0.1
RENOS_GAME_PORT=8788

# Öffentliche Adressen, wie der Browser sie sieht.
# Entwicklung: Frontend über Vite (5173), Spiele über den Game-Host (8788).
# Produktion z. B.: https://renos.example.com und https://games.renos.example.com
RENOS_APP_ORIGIN=http://localhost:5173
RENOS_GAME_ORIGIN=http://localhost:8788

# Datenverzeichnis für Datenbank, Uploads und installierte Spiele.
RENOS_DATA_DIR=./data

# Scrypt-Hash des Owner-Passworts. Erzeugen mit: npm run hash-password
# Ohne Hash: in der Entwicklung wird beim Start ein Einmal-Passwort in die Konsole geschrieben,
# in Produktion sind Upload und Löschen deaktiviert.
RENOS_OWNER_PASSWORD_HASH=

# Muss die Spieleliste ohne Anmeldung lesbar sein? (true/false)
RENOS_PUBLIC_LIBRARY=false

# Gültigkeit einer Anmeldung in Tagen.
RENOS_SESSION_TTL_DAYS=30

# Grenzen für Spielarchive.
RENOS_MAX_UPLOAD_MB=2048
RENOS_MAX_UNCOMPRESSED_MB=4096
RENOS_MAX_ARCHIVE_ENTRIES=20000
RENOS_MAX_COMPRESSION_RATIO=200

# Hinter einem Reverse Proxy (Caddy, nginx) auf true setzen, damit Client-IPs korrekt erkannt werden.
RENOS_TRUST_PROXY=false

# Pfad zum gebauten Frontend (wird in Produktion vom App-Server ausgeliefert). Leer = nicht ausliefern.
RENOS_WEB_DIST=./apps/web/dist

# Log-Level: fatal | error | warn | info | debug
RENOS_LOG_LEVEL=info
