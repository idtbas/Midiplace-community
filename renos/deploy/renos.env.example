# Kopieren nach deploy/renos.env und anpassen. Keine echten Zugangsdaten ins Repository!
RENOS_APP_ORIGIN=https://renos.example.com
RENOS_GAME_ORIGIN=https://games.renos.example.com
# Erzeugen mit: npm run hash-password
RENOS_OWNER_PASSWORD_HASH=
RENOS_PUBLIC_LIBRARY=false
RENOS_MAX_UPLOAD_MB=2048
RENOS_MAX_UNCOMPRESSED_MB=4096
RENOS_LOG_LEVEL=info
